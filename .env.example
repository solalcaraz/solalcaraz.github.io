# Copiar a .env y completar. El archivo .env no se sube al repositorio.

# Usuario de GitHub del que se leen los repos con el topic "portfolio".
GITHUB_USERNAME=solalcaraz

# Opcional. Sin token, GitHub permite 60 pedidos por hora y con la
# revalidación semanal alcanza. PENDIENTE: decidir si se usa.
# Si se usa, crear un token de solo lectura (sin permisos extra).
GITHUB_TOKEN=
