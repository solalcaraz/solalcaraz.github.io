---
import Base from "@/layouts/Base.astro";

// Página 404: no rompe la navegación, vuelve al inicio.
---

<Base titulo="Página no encontrada · María Sol Alcaraz" noindex>
  <main id="contenido" class="mx-auto flex min-h-svh w-full max-w-6xl flex-col justify-center px-4 sm:px-8">
    <p class="font-serif text-titulo-2 italic text-detalle" aria-hidden="true">404</p>
    <h1 class="mt-2 text-titulo-2">Esta página no existe</h1>
    <p class="mt-3 max-w-xl text-texto-suave">Puede que el enlace esté mal escrito o que ya no esté.</p>
    <a
      href="/"
      class="mt-8 inline-flex min-h-12 w-fit items-center rounded-full border border-borde-fuerte bg-superficie px-6 transition-colors hover:border-acento hover:bg-superficie-2"
    >
      Volver al inicio
    </a>
  </main>
</Base>
