---
import ThemeToggle from "@/components/ThemeToggle.astro";

// Barra de arriba, fija. Enlaza a las secciones y marca en cuál estás (subrayado que crece).
// Estilo "píldora flotante" centrada (2026-11-21). Sin rol escrito en la barra.
// Celular: hamburguesa con menú vertical desplegable, sin deslizar (2026-11-21).
const enlaces = [
  { href: "#proyectos", texto: "Proyectos" },
  { href: "#como-trabajo", texto: "Cómo trabajo" },
  { href: "#sobre-mi", texto: "Sobre mí" },
  { href: "#formacion", texto: "Formación" },
  { href: "#contacto", texto: "Contacto" },
];
---

<header class="pointer-events-none fixed inset-x-0 top-3 z-40 flex justify-center px-3 sm:top-4">
  <nav
    aria-label="Principal"
    class="pointer-events-auto relative flex w-full items-center justify-between gap-3 rounded-full border border-borde-fuerte/60 bg-superficie/80 py-1 pl-2 pr-2 text-texto-suave shadow-lg shadow-black/25 backdrop-blur-md md:w-auto md:justify-start md:gap-4 md:pl-7"
  >
    {/* Celular: botón de hamburguesa que abre el menú vertical. En pantallas grandes no se ve. */}
    <button
      type="button"
      data-menu-boton
      aria-expanded="false"
      aria-controls="menu-principal"
      class="group inline-flex min-h-11 items-center gap-3 rounded-full pl-3 pr-4 text-texto transition-colors hover:text-acento md:hidden"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-current stroke-2 group-aria-expanded:hidden" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="hidden size-5 fill-none stroke-current stroke-2 group-aria-expanded:block" stroke-linecap="round">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
      <span>Menú</span>
    </button>

    <ul
      id="menu-principal"
      data-nav-lista
      class="absolute inset-x-0 top-full mt-2 hidden flex-col gap-1 rounded-3xl border border-borde-fuerte/60 bg-superficie p-2 shadow-lg shadow-black/25 data-[abierto=true]:flex md:static md:mt-0 md:flex md:flex-row md:items-center md:gap-x-7 md:rounded-none md:border-0 md:bg-transparent md:p-0 md:px-1 md:shadow-none md:backdrop-blur-none"
    >
      {
        enlaces.map((enlace) => (
          <li class="md:shrink-0">
            <a href={enlace.href} data-nav-enlace class="nav-enlace">
              {enlace.texto}
            </a>
          </li>
        ))
      }
    </ul>
    <span aria-hidden="true" class="hidden h-6 w-px shrink-0 bg-borde-fuerte/60 md:block"></span>
    <ThemeToggle />
  </nav>
</header>

<script>
  // Marca en la barra la sección que se está leyendo.
  const lista = document.querySelector<HTMLElement>("[data-nav-lista]");
  const enlaces = [...document.querySelectorAll<HTMLAnchorElement>("[data-nav-enlace]")];
  const secciones = enlaces.flatMap((enlace) => {
    const seccion = document.querySelector<HTMLElement>(enlace.hash);
    return seccion ? [seccion] : [];
  });

  let actual = "";
  function marcar(id: string) {
    if (id === actual) return;
    actual = id;
    enlaces.forEach((enlace) => {
      if (enlace.hash === `#${id}`) enlace.setAttribute("aria-current", "true");
      else enlace.removeAttribute("aria-current");
    });
  }

  // Una franja fina en el medio de la pantalla: la sección que la cruza es la activa.
  const visibles = new Set<string>();
  const observador = new IntersectionObserver(
    (entradas) => {
      entradas.forEach((entrada) => {
        if (entrada.isIntersecting) visibles.add(entrada.target.id);
        else visibles.delete(entrada.target.id);
      });
      marcar(secciones.find((seccion) => visibles.has(seccion.id))?.id ?? "");
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );
  secciones.forEach((seccion) => observador.observe(seccion));

  // Menú de celular: se abre con el botón y se cierra al elegir una sección, con Escape,
  // tocando afuera o al pasar a una pantalla grande.
  const boton = document.querySelector<HTMLButtonElement>("[data-menu-boton]");
  function abrir(abierto: boolean) {
    if (!boton || !lista) return;
    lista.dataset.abierto = String(abierto);
    boton.setAttribute("aria-expanded", String(abierto));
    boton.setAttribute("aria-label", abierto ? "Cerrar menú" : "Abrir menú");
  }
  boton?.addEventListener("click", () => abrir(boton.getAttribute("aria-expanded") !== "true"));
  enlaces.forEach((enlace) => enlace.addEventListener("click", () => abrir(false)));
  document.addEventListener("keydown", (evento) => {
    if (evento.key === "Escape" && boton?.getAttribute("aria-expanded") === "true") {
      abrir(false);
      boton.focus();
    }
  });
  document.addEventListener("click", (evento) => {
    if (boton?.getAttribute("aria-expanded") === "true" && !(evento.target as Element).closest("nav")) abrir(false);
  });
  window.matchMedia("(min-width: 48rem)").addEventListener("change", (e) => e.matches && abrir(false));
</script>
