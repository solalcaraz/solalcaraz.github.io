---
// Portada: el nombre, una idea y una sola entrada a los proyectos.
//
// Textos confirmados por María Sol (2026-11-21), escritos con su guía de tono.
// Todo lo que dicen sale de lo que ella contó (la tecnología como herramienta simple,
// armar sitios, sistemas y herramientas pensando en quien los usa). Sin pedido de contratación.
//
// Efecto 1 (epic-design): las palabras suben al entrar. CSS puro, una sola vez; se apaga con
// la preferencia "reducir movimiento" del sistema (ver global.css).

import { CONTACTO } from "@/config/contacto";

// Atajos de contacto junto al botón (prueba del 2026-11-21; si recargan la portada, se sacan).
// Sin el mail: se arma al hacer clic y ese aviso se queda en la sección Contacto.
const atajoClase =
  "group/atajo relative inline-flex size-12 items-center justify-center rounded-full border border-borde text-texto-suave transition-colors hover:border-acento hover:text-acento";

type Palabra = { texto: string; cursiva?: boolean; pegado?: string };

// La frase principal. La cursiva serif es el acento (una sola palabra).
const frase: Palabra[] = [
  { texto: "Primero" },
  { texto: "entiendo" },
  { texto: "el" },
  { texto: "problema", cursiva: true, pegado: "." },
  { texto: "Después," },
  { texto: "el" },
  { texto: "código." },
];

// Cada palabra de la portada sube un poco después de la anterior.
const nombre = ["María", "Sol", "Alcaraz"];
const ordenFrase = (indice: number) => nombre.length + indice;
---

<section aria-labelledby="nombre" class="grano relative isolate">
<div class="mx-auto flex min-h-[78svh] w-full max-w-6xl flex-col justify-end px-4 pb-16 pt-32 sm:px-8">
  <h1 id="nombre" class="text-portada font-medium tracking-[-0.045em]">
    <span class="block">
      <span class="palabra" data-motion style="--orden:0">María</span>{" "}
      <span class="palabra" data-motion style="--orden:1">Sol</span>
    </span>{" "}
    <span class="block">
      <span class="palabra" data-motion style="--orden:2">Alcaraz</span>
      {/* Detalle: el asterisco del logo (confirmado). */}
      <span aria-hidden="true" data-motion class="asterisco font-serif align-top text-[0.55em] italic leading-none text-detalle">*</span>
    </span>
  </h1>

  <p class="mt-8 max-w-3xl text-titulo-2">
    {
      frase.map((palabra, indice) => (
        <>
          <span class="palabra" data-motion style={`--orden:${ordenFrase(indice)}`}>
            {palabra.cursiva ? <em class="font-serif">{palabra.texto}</em> : palabra.texto}
            {palabra.pegado}
          </span>{" "}
        </>
      ))
    }
  </p>

  <p class="mt-6 max-w-2xl text-texto-suave">
    Para mí la tecnología es una herramienta: tiene que ser simple y resolver lo que hace falta.
    Armo sitios, sistemas y herramientas pensando en quién los va a usar.
  </p>

  <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-4">
    <a
      href="#proyectos"
      class="group inline-flex min-h-12 items-center gap-3 rounded-full border border-borde-fuerte bg-superficie py-2 pl-6 pr-2 text-titulo-3 transition-colors hover:border-acento hover:bg-superficie-2"
    >
      Ver lo que construí
      <span
        aria-hidden="true"
        class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-acento text-sobre-acento transition-transform group-hover:translate-y-1"
      >
        ↓
      </span>
    </a>
    <ul class="flex items-center gap-2" aria-label="Contacto rápido">
      <li>
        <a href={CONTACTO.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (se abre en otra pestaña)" class={atajoClase}>
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-current stroke-2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect width="4" height="12" x="2" y="9"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
          <span aria-hidden="true" class="pointer-events-none absolute left-1/2 top-full z-10 mt-2 -translate-x-1/2 whitespace-nowrap rounded-full border border-borde bg-superficie px-3 py-1 text-chico text-texto opacity-0 transition-opacity group-hover/atajo:opacity-100 group-focus-visible/atajo:opacity-100">LinkedIn</span>
        </a>
      </li>
      <li>
        <a href={CONTACTO.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub (se abre en otra pestaña)" class={atajoClase}>
          <svg aria-hidden="true" viewBox="0 0 16 16" class="size-5 fill-current">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
          </svg>
          <span aria-hidden="true" class="pointer-events-none absolute left-1/2 top-full z-10 mt-2 -translate-x-1/2 whitespace-nowrap rounded-full border border-borde bg-superficie px-3 py-1 text-chico text-texto opacity-0 transition-opacity group-hover/atajo:opacity-100 group-focus-visible/atajo:opacity-100">GitHub</span>
        </a>
      </li>
      <li>
        <a href={CONTACTO.cv} download aria-label="Descargar CV (PDF)" class={atajoClase}>
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-current stroke-2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <path d="M14 2v6h6M8 13h8M8 17h8M8 9h2"></path>
          </svg>
          <span aria-hidden="true" class="pointer-events-none absolute left-1/2 top-full z-10 mt-2 -translate-x-1/2 whitespace-nowrap rounded-full border border-borde bg-superficie px-3 py-1 text-chico text-texto opacity-0 transition-opacity group-hover/atajo:opacity-100 group-focus-visible/atajo:opacity-100">CV</span>
        </a>
      </li>
    </ul>
  </div>
</div>
</section>
